{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": { "includes": ["src/**/*.ts"] },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "complexity": { "noForEach": "off", "useLiteralKeys": "off" },
      "style": { "noNonNullAssertion": "warn", "useConst": "error" }
    }
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 }
}
